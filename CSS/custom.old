/* ========================================
   SISTEMA DE ESTOQUE TI - CSS PERSONALIZADO (VERSÃO FINAL)
   ======================================== */

:root {
    --primary-color: #0d6efd;
    --primary-dark: #0a58ca;
    --primary-light: #3b82f6;
    --secondary-color: #6c757d;
    --accent-color: #0ea5e9;
    --light-bg: #f8f9fa;
    --text-light: #ffffff;
    --text-dark: #212529;
    --border-color: #e9ecef;
    --hover-color: rgba(255, 255, 255, 0.1);
    --active-color: #0b5ed7;
    --border-radius-base: 0.375rem;
    --box-shadow-base: 0 4px 15px rgba(0, 0, 0, 0.07);
    --sidebar-width: 250px;
    --sidebar-collapsed-width: 60px;
    --transition-speed: 0.3s;
}

body {
    background-color: var(--light-bg);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    color: var(--text-dark);
    overflow-x: hidden;
}

.wrapper {
    display: flex;
    width: 100%;
    min-height: 100vh;
    align-items: stretch;
}

#main-content-wrapper {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    overflow: auto;
    min-width: 0;
}

/* ========================================
   SIDEBAR - ANIMAÇÃO FLUIDA E ALINHAMENTO PERFEITO
   ======================================== */
.sidebar-custom {
    width: var(--sidebar-width);
    min-width: var(--sidebar-width);
    background: var(--primary-color);
    transition: width var(--transition-speed) ease, min-width var(--transition-speed) ease, transform var(--transition-speed) ease;
    height: 100vh;
    position: sticky;
    top: 0;
    z-index: 1032;
    overflow-x: hidden;
    flex-shrink: 0;
}

.sidebar-custom.collapsed {
    width: var(--sidebar-collapsed-width);
    min-width: var(--sidebar-collapsed-width);
}

.sidebar-header {
    height: 60px;
    padding: 0 1rem;
    display: flex;
    align-items: center;
}

.sidebar-brand-toggle {
    cursor: pointer;
    display: flex;
    align-items: center;
    width: 100%;
    color: var(--text-light);
    text-decoration: none;
    padding: .5rem;
    border-radius: var(--border-radius-base);
}
.sidebar-brand-toggle:hover {
    background-color: var(--hover-color);
}


.sidebar-divider {
    border-color: rgba(255,255,255,0.2) !important;
}

.sidebar-link {
    color: rgba(255, 255, 255, 0.85);
    padding: 12px 1rem;
    border-radius: var(--border-radius-base);
    margin: 2px 0;
    display: flex;
    align-items: center;
    white-space: nowrap;
    overflow: hidden;
    transition: all 0.2s ease-in-out;
    border: 2px solid transparent;
}

.sidebar-link .fa-fw {
    font-size: 1.1em;
    width: 30px;
    flex-shrink: 0;
    text-align: center;
    transition: font-size 0.3s ease;
}

.sidebar-link .sidebar-text {
    margin-left: 10px;
    opacity: 1;
    transition: opacity 0.2s ease;
}

.sidebar-custom.collapsed .sidebar-link .sidebar-text,
.sidebar-custom.collapsed .sidebar-header .sidebar-text {
    opacity: 0;
    pointer-events: none;
}

.sidebar-custom.collapsed .sidebar-link {
    justify-content: center;
    padding: 0;
    width: 44px;
    height: 44px;
    margin: 4px auto;
}
.sidebar-custom.collapsed .sidebar-link .fa-fw {
    font-size: 1.3em;
    width: auto;
}
.sidebar-custom.collapsed .sidebar-link .sidebar-text {
    display: none;
}

.sidebar-link:hover {
    background-color: var(--hover-color);
    color: var(--text-light);
}

.sidebar-link.active,
.sidebar-link[aria-expanded="true"] {
    background-color: var(--hover-color) !important;
    color: var(--text-light);
    font-weight: 500;
}

.sidebar-custom.collapsed .sidebar-link.active,
.sidebar-custom.collapsed .sidebar-link[aria-expanded="true"] {
    background-color: var(--primary-light) !important;
    border-radius: 50%;
    border: 2px solid transparent;
}

/* ========================================
   ESTILO DO AVATAR NO CABEÇALHO
   ======================================== */
.navbar .dropdown-toggle .avatar-image {
    width: 24px;
    height: 24px;
    object-fit: cover;
    border-radius: 50%;
}

.navbar .dropdown-toggle .avatar-icon {
    font-size: 1.5rem;
    line-height: 1;
}

/* ========================================
   BACKDROP E OUTROS ESTILOS
   ======================================== */
.sidebar-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 1035; /* Abaixo do sidebar, acima do conteúdo */
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0s 0.3s;
}

.sidebar-backdrop.show {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s ease;
}

.btn-primary-custom { background-color: var(--primary-color); border-color: var(--primary-color); color: var(--text-light); }
.btn-primary-custom:hover { background-color: var(--primary-dark); border-color: var(--primary-dark); }
.btn-secondary-custom { background-color: var(--secondary-color); border-color: var(--secondary-color); color: var(--text-light); }
.btn-secondary-custom:hover { background-color: #5a6268; border-color: #545b62; color: var(--text-light); }
.text-primary-custom { color: var(--primary-color) !important; }
.card-custom { border: 1px solid var(--border-color); border-radius: var(--border-radius-base); box-shadow: var(--box-shadow-base); }
.card-header-custom { background-color: #fff; border-bottom: 1px solid var(--border-color); font-weight: 600; color: var(--primary-dark); }
.alert-custom { border-radius: var(--border-radius-base); }
#alert-container { position: fixed; top: 80px; right: 20px; z-index: 1056; min-width: 300px; }

.badge-dark-text {
    color: var(--text-dark) !important;
}

.sidebar-logo {
    width: 45px;
    height: 45px;
    object-fit: contain;
    border-radius: 4px;
    flex-shrink: 0;
}

.sidebar-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.2;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sidebar-slogan {
    font-size: 0.7rem;
    font-weight: 300;
    opacity: 0.8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.sidebar-title {
    font-size: 1.1rem;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.product-card .card-img-top {
    height: 180px;
    width: 100%;
    object-fit: contain;
    padding: 0.5rem;
    background-color: #fdfdfd;
}

.product-icon-placeholder {
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f8f9fa;
    border-bottom: 1px solid var(--border-color);
    padding: 1rem;
}

.product-card {
    transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
}
.product-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
}
.product-card .card-body {
    transition: all 0.3s ease;
    border-bottom-left-radius: var(--bs-card-inner-border-radius);
    border-bottom-right-radius: var(--bs-card-inner-border-radius);
}
.product-card:hover .card-body {
    background-color: var(--primary-color);
    color: #ffffff;
}
.product-card:hover .card-body h6,
.product-card:hover .card-body p,
.product-card:hover .card-body small,
.product-card:hover .card-body strong {
    color: #ffffff !important;
}
.product-card:hover .card-body .badge {
    background-color: rgba(255, 255, 255, 0.9) !important;
    color: #000000 !important;
}
.product-card:hover .card-footer {
    border-top: none;
}

.product-card.card-custom {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border-radius: 12px;
}
.product-card .card-body {
    flex-grow: 1;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.product-card .card-footer {
    display: flex;
    justify-content: center;
    padding: 0.75rem;
    background-color: transparent;
    border-top: 1px solid var(--border-color);
}
.product-card .card-footer .btn {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0 4px;
    border-radius: 8px;
    font-size: 1.1rem;
    transition: all 0.2s ease-in-out;
}

/* ========================================
   CSS RESPONSIVO
   ======================================== */

@media (min-width: 1600px) {
    main.flex-grow-1 {
        max-width: 1500px;
        margin-left: auto;
        margin-right: auto;
        width: 100%;
    }
}

@media (max-width: 991.98px) {
    .sidebar-custom {
        position: fixed;
        left: 0;
        top: 0;
        transform: translateX(-100%); /* Inicia escondido */
        z-index: 1040;
        width: var(--sidebar-width); /* Garante largura total quando abrir */
        min-width: var(--sidebar-width);
    }
    
    /* Remove o efeito da classe 'collapsed' na posição ou largura no mobile */
    .sidebar-custom.collapsed {
        transform: translateX(-100%);
        width: var(--sidebar-width);
        min-width: var(--sidebar-width);
    }
    
    /* Classe '.show' controla a visibilidade no mobile */
    .sidebar-custom.show {
        transform: translateX(0);
        box-shadow: 0 0 1rem rgba(0,0,0,.15);
    }

    /* Garante que o menu abra mesmo se estava 'collapsed' */
    .sidebar-custom.collapsed.show {
        transform: translateX(0);
    }
}

@media (max-width: 767.98px) {
    .d-flex.border-bottom {
        flex-direction: column;
        align-items: flex-start !important;
    }

    .d-flex.border-bottom h1 {
        margin-bottom: 0.75rem;
    }

    .d-flex.border-bottom .btn-toolbar {
        width: 100%;
        margin-top: 0.5rem;
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
    }

    .d-flex.border-bottom .btn-toolbar .btn-group {
        width: auto;
    }

    .d-flex.justify-content-between.align-items-center.mb-3 {
        flex-direction: column;
        align-items: center !important;
        gap: 0.75rem;
    }

    .table-responsive .table th,
    .table-responsive .table td {
        padding: 0.5rem 0.4rem;
        font-size: 0.9rem;
        white-space: nowrap;
    }

    .card-body .row.g-3 > [class*="col-"] {
        padding-bottom: 0.5rem;
    }

    .card-body .row.g-3 .form-label {
        margin-bottom: 0.25rem;
    }
    
    .product-card .card-footer > div {
        display: flex !important;
        flex-wrap: nowrap !important;
        justify-content: center !important;
        gap: 0.25rem !important;
    }

    .product-card .card-footer .btn {
        flex-grow: 1;
        flex-shrink: 1;
        min-width: 38px;
        padding: 0.5rem;
    }
}